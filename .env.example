# Copy to .env and fill in. `.env` is gitignored.
# Read by agent_framework.openai.OpenAIChatClient when Azure routing is selected.

# --- Azure OpenAI (required) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_MODEL=<your-deployment-name>

# Key auth. Leave unset to use Entra ID instead (pass credential=AzureCliCredential()).
AZURE_OPENAI_API_KEY=<your-api-key>

# Optional. OpenAIChatClient targets the Responses API and defaults to "preview".
# AZURE_OPENAI_API_VERSION=preview

# --- MCP servers used by the notebooks (optional) ---
# Microsoft Learn MCP (public, no auth)
MCP_LEARN_URL=https://learn.microsoft.com/api/mcp
# Local Playwright MCP: npx @playwright/mcp@latest --port 8931
MCP_LOCAL_URL=http://localhost:8931/mcp
